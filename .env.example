# Copy this file to .env and fill in the values before running the server.

PORT=3000

# Change this to a long, random string (e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login credentials
ADMIN_USERNAME=admin

# Generate the hash with:  node -e "require('bcryptjs').hash('YOUR_PASSWORD_HERE',10).then(h=>console.log(h))"
# Paste the output below (it starts with $2b$)
ADMIN_PASSWORD_HASH=

# WhatsApp number (no + or spaces) — used in storefront enquiry links
WHATSAPP_NUMBER=919428940074
