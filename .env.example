# Copy this file to .env and fill in the values before running the server.

PORT=3000

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# REQUIRED — the server will not start without a valid DATABASE_URL.
#
# Option A — Neon.tech (free, no credit card, fastest to set up):
#   1. Sign up at https://neon.tech
#   2. Create a project → copy the connection string from the dashboard
#   Connection string looks like: postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Option B — Render (free 90-day PostgreSQL add-on):
#   In your Render service dashboard → "Add PostgreSQL" → copy "External Database URL"
#
# Option C — Local PostgreSQL install:
#   postgresql://postgres:yourpassword@localhost:5432/rajshree
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Session secret ────────────────────────────────────────────────────────
# Change this to a long, random string (e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Admin login ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# Generate the hash with:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD_HERE',10).then(h=>console.log(h))"
# Paste the output below (it starts with $2b$)
# Only needed on first startup — after that the hash is stored in the database.
ADMIN_PASSWORD_HASH=

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Phone number (no + or spaces) — used in storefront enquiry links
WHATSAPP_NUMBER=919428940074

# ─── Cloudinary (image hosting) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

